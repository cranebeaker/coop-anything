#include <winver.h>
#include "ddcoop-mascot.rc"

1 24 "ddcoop.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "DDCoop - Darkest Dungeon co-op launcher"
      VALUE "ProductName", "DDCoop"
      VALUE "FileVersion", "1.0.0"
      VALUE "OriginalFilename", "DDCoop.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
